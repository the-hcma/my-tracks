[Unit]
Description=My Tracks – OwnTracks location tracking server
Documentation=https://github.com/the-hcma/my-tracks
After=network.target

[Service]
Type=simple
WorkingDirectory=@@REPO_DIR@@
Environment=LOG_FILE=%h/scratch/my-tracks/my-tracks.log
ExecStart=@@REPO_DIR@@/scripts/my-tracks-server --http-port 8080 --log-level info --console --log-file %h/scratch/my-tracks/my-tracks.log
ExecStartPost=/bin/bash -c 'i=0; while [ $i -lt 30 ]; do sleep 1; curl -sf http://localhost:8080/api/health/ && exit 0; i=$((i+1)); done; exit 1'
Restart=on-failure
RestartSec=5s

# Baseline hardening (my-tracks#1400). ``NoNewPrivileges`` and ``SystemCallArchitectures`` are enforced everywhere.
# ``RestrictAddressFamilies`` is enforced on x86-64 and aarch64 but ignored on 32-bit x86, s390, mips and ppc ABIs,
# and it does not cover 32-bit calls on a host that also runs 32-bit x86 code, so it is paired with
# ``SystemCallArchitectures=native``. ``PrivateTmp`` and ``ProtectSystem`` need a mount namespace, which a user
# manager builds inside an unprivileged user namespace: where that is not allowed
# (``kernel.apparmor_restrict_unprivileged_userns=1``) systemd starts the unit without them and without an error, so
# they take effect only on hosts that allow it. ``PrivateTmp`` is worth having here: the MQTT broker writes its TLS
# key and certificates to the temp directory for the SSL context, and a private /tmp that systemd removes at stop
# keeps them from lingering after a crash. A local PostgreSQL whose Unix socket is under /tmp would be hidden by it:
# use a socket directory outside /tmp, or set ``PrivateTmp=false`` in a drop-in. ``ProtectHome`` and
# ``ProtectSystem=strict`` stay off on purpose: the log is under the home directory and the SQLite database and
# media live in the checkout. ``AF_NETLINK`` is the C library's interface listing; raw packet sockets are not used.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=default.target
